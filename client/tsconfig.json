{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "lib": ["DOM", "ESNext"],
    "moduleResolution": "bundler",
    "target": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "nativewind/types"
    ],
    "paths": {
      "@env": [
        "./expo-env.d.ts"
      ],
      "@config/*": [
        "./config/*"
      ],
      "@components/*": [
        "./components/*"
      ]
    }
  },
  "include": [
    "expo-env.d.ts",
    "app",
    "components",
    "config",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}

